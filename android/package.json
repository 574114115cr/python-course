{
  "name": "python-course-android",
  "version": "1.0.0",
  "private": true,
  "description": "Python 学习课程包 · 安卓壳（Capacitor 8，webDir 由 tools/build_android_www.py 组装）",
  "scripts": {
    "www": "python ../tools/build_android_www.py",
    "assets": "python ../tools/build_app_assets.py",
    "sync": "npx cap sync android",
    "open": "npx cap open android",
    "apk:debug": "cd android && ./gradlew assembleDebug --no-daemon"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3"
  }
}
