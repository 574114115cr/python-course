            </Box>
            <Box style={{ background: '#EEF5FB', borderRadius: 8, padding: '12px 14px', marginTop: 'auto' }}>
                <Text style={{ fontSize: 13, color: '#8A9AAA' }}>适合</Text>
                <Text style={{ fontSize: 15, color: '#1F5FA8', fontWeight: 'bold' }}>想重点巩固类与面向对象的学员</Text>
            </Box>
        </Box>

        <Box style={{
            flex: 1, background: '#FFFFFF', border: '1px solid #D8E3EE', borderRadius: 12,
            padding: 20, flexDirection: 'column', gap: 12,
        }}>
            <Box style={{ flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
                <Text style={{ fontSize: 46, fontWeight: 'bold', color: '#0E9B78', lineHeight: 1 }}>C</Text>
