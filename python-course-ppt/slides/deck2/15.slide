            <text fontFamily='Microsoft YaHei' x='602' y='228' fontSize='12.5' fill='#5A6B7A' textAnchor='middle'>取字段 · 算极值 · 排序</text>

            <path d='M716 215 L 736 215' stroke='#1F5FA8' strokeWidth='3' fill='none' />
            <path d='M728 209 L 736 215 L 728 221' stroke='#1F5FA8' strokeWidth='3' fill='none' />

            <rect x='744' y='176' width='212' height='78' rx='9' fill='#EEF5FB' />
