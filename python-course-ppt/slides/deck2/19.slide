<Slide style={{
    width: '1280px', height: '720px', backgroundColor: '#FAFCFE',
    padding: 0, position: 'relative', overflow: 'hidden',
}}>
    <Box style={{ position: 'absolute', left: 64, top: 40, width: '1152px', flexDirection: 'column' }}>
        <Text style={{ fontSize: 36, fontWeight: 'bold', color: '#16232E' }}>练习题库 · 六档递进共 120 题</Text>
        <Text style={{ fontSize: 18, color: '#5A6B7A', marginTop: 6 }}>
            每题都有参考答案与解析。卡 15 分钟再看答案，看完必须关掉重写一遍
        </Text>
    </Box>

    <Box style={{ position: 'absolute', left: 52, top: 152, width: '730px', height: 400 }}>
        <svg width='730' height='400' viewBox='0 0 730 400'>
            <line x1='20' y1='340' x2='710' y2='340' stroke='#D8E3EE' strokeWidth='2' />
            <rect x='26' y='260' width='86' height='80' rx='6' fill='#1F5FA8' />
            <text x='69' y='290' fontSize='22' fontWeight='bold' fill='#FFFFFF' textAnchor='middle' fontFamily='Inter'>L1</text>
            <text fontFamily='Microsoft YaHei' x='69' y='314' fontSize='13' fill='#CFE2F5' textAnchor='middle'>16 题</text>
            <text fontFamily='Microsoft YaHei' x='69' y='366' fontSize='12' fill='#5A6B7A' textAnchor='middle'>变量 / 列表</text>
            <text fontFamily='Microsoft YaHei' x='69' y='386' fontSize='12' fill='#8A9AAA' textAnchor='middle'>3 小时</text>
            <rect x='140' y='230' width='86' height='110' rx='6' fill='#1F5FA8' />
            <text x='183' y='260' fontSize='22' fontWeight='bold' fill='#FFFFFF' textAnchor='middle' fontFamily='Inter'>L2</text>
            <text fontFamily='Microsoft YaHei' x='183' y='284' fontSize='13' fill='#CFE2F5' textAnchor='middle'>24 题</text>
            <text fontFamily='Microsoft YaHei' x='183' y='366' fontSize='12' fill='#5A6B7A' textAnchor='middle'>循环 / 条件 /</text>
            <text fontFamily='Microsoft YaHei' x='183' y='386' fontSize='12' fill='#8A9AAA' textAnchor='middle'>6 小时</text>
            <rect x='254' y='200' width='86' height='140' rx='6' fill='#2F7BC8' />
            <text x='297' y='230' fontSize='22' fontWeight='bold' fill='#FFFFFF' textAnchor='middle' fontFamily='Inter'>L3</text>
            <text fontFamily='Microsoft YaHei' x='297' y='254' fontSize='13' fill='#EAF3FC' textAnchor='middle'>10 题</text>
            <text fontFamily='Microsoft YaHei' x='297' y='366' fontSize='12' fill='#5A6B7A' textAnchor='middle'>函数 / 递归 /</text>
            <text fontFamily='Microsoft YaHei' x='297' y='386' fontSize='12' fill='#8A9AAA' textAnchor='middle'>4 小时</text>
            <rect x='368' y='170' width='86' height='170' rx='6' fill='#0E9B78' />
