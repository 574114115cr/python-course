            <text fontFamily='Microsoft YaHei' x='411' y='224' fontSize='13' fill='#D7F0E7' textAnchor='middle'>10 题</text>
            <text fontFamily='Microsoft YaHei' x='411' y='366' fontSize='12' fill='#5A6B7A' textAnchor='middle'>类 / 继承 /</text>
            <text fontFamily='Microsoft YaHei' x='411' y='386' fontSize='12' fill='#8A9AAA' textAnchor='middle'>5 小时</text>
            <rect x='482' y='140' width='86' height='200' rx='6' fill='#E08A15' />
            <text x='525' y='170' fontSize='22' fontWeight='bold' fill='#FFFFFF' textAnchor='middle' fontFamily='Inter'>L5</text>
            <text fontFamily='Microsoft YaHei' x='525' y='194' fontSize='13' fill='#FDF0DC' textAnchor='middle'>10 题</text>
            <text fontFamily='Microsoft YaHei' x='525' y='366' fontSize='12' fill='#5A6B7A' textAnchor='middle'>文件 / 异常 /</text>
            <text fontFamily='Microsoft YaHei' x='525' y='386' fontSize='12' fill='#8A9AAA' textAnchor='middle'>6 小时</text>
            <rect x='596' y='110' width='86' height='230' rx='6' fill='#8A5A08' />
            <text x='639' y='140' fontSize='22' fontWeight='bold' fill='#FFFFFF' textAnchor='middle' fontFamily='Inter'>L6</text>
            <text fontFamily='Microsoft YaHei' x='639' y='164' fontSize='13' fill='#F3E2CC' textAnchor='middle'>50 题</text>
            <text fontFamily='Microsoft YaHei' x='639' y='366' fontSize='12' fill='#5A6B7A' textAnchor='middle'>项目 / 工程 /</text>
