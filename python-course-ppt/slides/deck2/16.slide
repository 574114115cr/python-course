    <Box style={{ position: 'absolute', left: 64, top: 140, width: '1152px', height: 292 }}>
        <svg width='1152' height='292' viewBox='0 0 1152 292'>
            <text fontFamily='Microsoft YaHei' x='0' y='18' fontSize='15' fontWeight='bold' fill='#16232E'>一次请求的旅程（单元 18 的核心）</text>

            <rect x='0' y='34' width='152' height='72' rx='9' fill='#1F5FA8' />
            <text fontFamily='Microsoft YaHei' x='76' y='64' fontSize='14.5' fontWeight='bold' fill='#FFFFFF' textAnchor='middle'>浏览器</text>
            <text fontFamily='Microsoft YaHei' x='76' y='88' fontSize='12' fill='#CFE2F5' textAnchor='middle'>访问一个 URL</text>

            <path d='M160 70 L 186 70' stroke='#1F5FA8' strokeWidth='3' fill='none' />
            <path d='M178 64 L 186 70 L 178 76' stroke='#1F5FA8' strokeWidth='3' fill='none' />

            <rect x='194' y='34' width='152' height='72' rx='9' fill='#2F7BC8' />
            <text x='270' y='64' fontSize='14.5' fontWeight='bold' fill='#FFFFFF' textAnchor='middle' fontFamily='Inter'>urls.py</text>
            <text fontFamily='Microsoft YaHei' x='270' y='88' fontSize='12' fill='#EAF3FC' textAnchor='middle'>找路由</text>

            <path d='M354 70 L 380 70' stroke='#2F7BC8' strokeWidth='3' fill='none' />
            <path d='M372 64 L 380 70 L 372 76' stroke='#2F7BC8' strokeWidth='3' fill='none' />

