<Slide style={{
    width: '1280px', height: '720px', backgroundColor: '#FAFCFE',
    padding: 0, position: 'relative', overflow: 'hidden',
}}>
    <Box style={{ position: 'absolute', left: 64, top: 40, width: '1152px', flexDirection: 'column' }}>
        <Text style={{ fontSize: 36, fontWeight: 'bold', color: '#16232E' }}>练习题库 · 五档递进共 52 题</Text>
        <Text style={{ fontSize: 18, color: '#5A6B7A', marginTop: 6 }}>
            每题都有参考答案与解析。卡 15 分钟再看答案，看完必须关掉重写一遍
        </Text>
    </Box>

    <Box style={{ position: 'absolute', left: 64, top: 152, width: '700px', height: 400 }}>
        <svg width='700' height='400' viewBox='0 0 700 400'>
