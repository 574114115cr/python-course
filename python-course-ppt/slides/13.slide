            <text x='132' y='366' fontSize='13' fill='#5A6B7A' textAnchor='middle' fontFamily='Inter'>变量 / 列表</text>
            <text x='132' y='388' fontSize='13' fill='#8A9AAA' textAnchor='middle' fontFamily='Inter'>3 小时</text>

            <rect x='204' y='210' width='104' height='130' rx='6' fill='#1F5FA8' />
            <text x='256' y='252' fontSize='24' fontWeight='bold' fill='#FFFFFF' textAnchor='middle' fontFamily='Inter'>L2</text>
            <text x='256' y='284' fontSize='14' fill='#CFE2F5' textAnchor='middle' fontFamily='Inter'>16 题</text>
            <text x='256' y='312' fontSize='13' fill='#5A6B7A' textAnchor='middle' fontFamily='Inter'>循环 / 条件 /</text>
            <text x='256' y='332' fontSize='13' fill='#5A6B7A' textAnchor='middle' fontFamily='Inter'>字典 / while</text>
            <text x='256' y='366' fontSize='13' fill='#8A9AAA' textAnchor='middle' fontFamily='Inter'>6 小时</text>

            <rect x='328' y='180' width='104' height='160' rx='6' fill='#2F7BC8' />
            <text x='380' y='228' fontSize='24' fontWeight='bold' fill='#FFFFFF' textAnchor='middle' fontFamily='Inter'>L3</text>
            <text x='380' y='260' fontSize='14' fill='#FFFFFF' textAnchor='middle' fontFamily='Inter'>8 题</text>
            <text x='380' y='288' fontSize='13' fill='#EAF3FC' textAnchor='middle' fontFamily='Inter'>函数 / 递归 /</text>
            <text x='380' y='308' fontSize='13' fill='#EAF3FC' textAnchor='middle' fontFamily='Inter'>装饰器 / 模块</text>
            <text x='380' y='366' fontSize='13' fill='#8A9AAA' textAnchor='middle' fontFamily='Inter'>4 小时</text>

            <rect x='452' y='150' width='104' height='190' rx='6' fill='#0E9B78' />
            <text x='504' y='205' fontSize='24' fontWeight='bold' fill='#FFFFFF' textAnchor='middle' fontFamily='Inter'>L4</text>
            <text x='504' y='237' fontSize='14' fill='#FFFFFF' textAnchor='middle' fontFamily='Inter'>8 题</text>
            <text x='504' y='265' fontSize='13' fill='#D7F0E7' textAnchor='middle' fontFamily='Inter'>类 / 继承 /</text>
            <text x='504' y='285' fontSize='13' fill='#D7F0E7' textAnchor='middle' fontFamily='Inter'>组合 / dataclass</text>
            <text x='504' y='366' fontSize='13' fill='#8A9AAA' textAnchor='middle' fontFamily='Inter'>5 小时</text>

            <rect x='576' y='112' width='104' height='228' rx='6' fill='#E08A15' />
